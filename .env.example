# Chave secreta da API (painel Broski -> Configurações -> API).
# NUNCA no browser, nunca no repositório, nunca numa app móvel.
BROSKI_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx

# Segredo do webhook (painel -> Configurações -> Webhooks -> Ver segredo).
BROSKI_WEBHOOK_SECRET=whbroski_xxxxxxxxxxxxxxxxxxxx

# URL pública HTTPS desta app. Vai para checkout_url e tem de bater certo
# com a URL registada no painel (com/sem www importa; 3xx conta como falha).
PUBLIC_URL=https://a-sua-loja.pt

PORT=3000

# Só para testes locais com o mock. Em produção NÃO defina esta variável.
# BROSKI_BASE_URL=http://localhost:4010
